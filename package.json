{
  "name": "alight",
  "version": "0.6.1",
  "build": 14,
  "description": "A tiny native macOS menu bar gauge for Codex, Claude Code, and Antigravity usage pressure.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/owl-and-kestrel/alight.git"
  },
  "bin": {
    "alight": "./bin/alight.mjs"
  },
  "files": [
    "bin/",
    "config/",
    "Package.swift",
    "Package.resolved",
    "Sources/",
    "Tests/",
    "docs/",
    "script/",
    "swiftbar/",
    "scripts/",
    "README.md",
    "spec.md",
    "LICENSE"
  ],
  "scripts": {
    "build:core": "node ./scripts/build-core.mjs",
    "build:native": "./script/build_and_run.sh --build",
    "check": "node --check ./bin/alight.mjs",
    "check:core": "node ./scripts/build-core.mjs --check",
    "migrate:data": "./scripts/migrate-alight-data.sh",
    "package:release": "./script/package_release.sh",
    "release:dry-run": "node ./scripts/publish-release.mjs",
    "release:publish": "node ./scripts/publish-release.mjs --publish",
    "test": "node --test",
    "test:swift": "./script/test_swift.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@owl-kestrel/hatch-contracts": "0.3.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
